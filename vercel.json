{
  "name": "grabit",
  "buildCommand": "cd grabit-app && npm install && npm run build",
  "outputDirectory": "grabit-app/dist",
  "framework": null,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/uploads/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
